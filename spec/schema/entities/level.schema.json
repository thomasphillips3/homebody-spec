{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://homebody.app/schema/entities/level.schema.json",
  "title": "Level",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "home_id", "name", "sort_order", "elevation_offset_m", "scale_confidence"],
  "properties": {
    "id": { "type": "string", "format": "uuid" },
    "home_id": { "type": "string", "format": "uuid" },
    "name": { "type": "string" },
    "sort_order": { "type": "integer" },
    "elevation_offset_m": { "type": "number" },
    "scale_confidence": {
      "type": "string",
      "enum": ["measured", "estimated"]
    },
    "import_attachment_id": { "type": ["string", "null"], "format": "uuid" },
    "import_origin_m": {
      "type": ["array", "null"],
      "items": { "type": "number" },
      "minItems": 2,
      "maxItems": 2
    },
    "import_scale_m_per_px": { "type": ["number", "null"] },
    "import_pixel_width": { "type": ["integer", "null"] },
    "import_pixel_height": { "type": ["integer", "null"] },
    "scan_usdz_attachment_id": {
      "type": ["string", "null"],
      "format": "uuid",
      "description": "Soft reference (not a foreign key) to the usdz_mesh Attachment of a RoomPlan scan; the level patch can sync before the attachment row."
    },
    "scan_structure_attachment_id": {
      "type": ["string", "null"],
      "format": "uuid",
      "description": "Soft reference (not a foreign key) to the roomplan_structure Attachment holding the captured structure JSON."
    },
    "scan_glb_attachment_id": {
      "type": ["string", "null"],
      "format": "uuid",
      "description": "Soft reference (not a foreign key) to the gltf_mesh Attachment used by Android and web 3D viewers."
    },
    "scan_origin_m": {
      "type": ["array", "null"],
      "items": { "type": "number" },
      "minItems": 2,
      "maxItems": 2,
      "description": "Translation in meters from scan XZ (after rotation) to plan space."
    },
    "scan_rotation_rad": {
      "type": ["number", "null"],
      "description": "Rotation in radians from scan XZ to plan space. planPoint = R(rotation) * (X, Z) + scan_origin_m."
    },
    "scan_review_state": {
      "type": ["string", "null"],
      "enum": ["pending_review", "reviewed", null]
    }
  }
}
