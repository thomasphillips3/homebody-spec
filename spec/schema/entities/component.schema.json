{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://homebody.app/schema/entities/component.schema.json",
  "title": "Component",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "system_id",
    "name",
    "component_type",
    "condition",
    "room_ids",
    "custom_fields"
  ],
  "properties": {
    "id": { "type": "string", "format": "uuid" },
    "system_id": { "type": "string", "format": "uuid" },
    "name": { "type": "string" },
    "component_type": {
      "type": "string",
      "enum": [
        "plumbing_fixture",
        "toilet",
        "sink",
        "bathtub_shower",
        "main_water_shutoff",
        "gas_shutoff",
        "water_supply_line",
        "drain_waste_vent",
        "sewer_lateral",
        "sump_pump",
        "water_treatment",
        "electrical_panel",
        "subpanel",
        "electric_meter",
        "service_conductors",
        "branch_circuit",
        "outlet",
        "gfci_receptacle",
        "light_fixture",
        "smoke_detector",
        "co_detector",
        "generator",
        "solar_pv_system",
        "hvac_furnace",
        "hvac_ac_unit",
        "hvac_heat_pump",
        "hvac_mini_split",
        "hvac_boiler",
        "hvac_air_handler",
        "hvac_ductwork",
        "thermostat",
        "hvac_filter",
        "hvac_ventilation_fan",
        "hvac_fireplace",
        "roof_covering",
        "flashing",
        "skylight",
        "chimney",
        "roof_vent",
        "gutter",
        "downspout",
        "soffit_fascia",
        "attic_insulation",
        "foundation",
        "structural_member",
        "water_heater",
        "refrigerator",
        "dishwasher",
        "range_oven",
        "microwave",
        "range_hood",
        "clothes_washer",
        "clothes_dryer",
        "garbage_disposal",
        "appliance_generic",
        "exterior_wall_covering",
        "window",
        "exterior_door",
        "garage_door",
        "garage_door_opener",
        "deck_porch_patio",
        "driveway_walkway",
        "fence_wall",
        "irrigation_system",
        "septic_system",
        "well_pump",
        "pool_spa",
        "camera",
        "video_doorbell",
        "network_router",
        "network_access_point",
        "smart_hub",
        "smart_lock",
        "alarm_panel",
        "leak_sensor",
        "structured_wiring_panel",
        "low_voltage_cabling",
        "other"
      ]
    },
    "make": { "type": ["string", "null"] },
    "model": { "type": ["string", "null"] },
    "manual_url": { "type": ["string", "null"], "format": "uri" },
    "location_note": { "type": ["string", "null"] },
    "serial_number": { "type": ["string", "null"] },
    "install_date": { "type": ["string", "null"], "format": "date" },
    "warranty_start": { "type": ["string", "null"], "format": "date" },
    "warranty_length_months": { "type": ["integer", "null"] },
    "manual_attachment_id": { "type": ["string", "null"], "format": "uuid" },
    "service_interval_days": { "type": ["integer", "null"] },
    "last_serviced_at": { "type": ["string", "null"], "format": "date" },
    "condition": { "$ref": "./condition.schema.json" },
    "level_id": { "type": ["string", "null"], "format": "uuid" },
    "room_ids": {
      "type": "array",
      "items": { "type": "string", "format": "uuid" },
      "default": []
    },
    "geometry": {
      "anyOf": [
        { "$ref": "./plan-geometry.schema.json" },
        { "type": "null" }
      ],
      "default": null
    },
    "notes": { "type": ["string", "null"] },
    "linked_component_id": { "type": ["string", "null"], "format": "uuid" },
    "custom_fields": {
      "type": "object",
      "additionalProperties": true,
      "default": {}
    }
  }
}
