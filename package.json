{
  "name": "homebody-spec",
  "version": "0.6.0",
  "description": "The Home Record spec: open, versioned JSON Schema plus generated Swift/Kotlin/TypeScript models and golden fixtures.",
  "license": "MIT",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./schema": "./spec/schema/home-record.schema.json",
    "./render": {
      "types": "./dist/render/index.d.ts",
      "import": "./dist/render/index.js",
      "require": "./dist/render/index.js",
      "default": "./dist/render/index.js"
    }
  },
  "files": [
    "dist/",
    "spec/schema/",
    "spec/render/style-tokens.json",
    "spec/fixtures/render/",
    "spec/fixtures/roomplan/",
    "spec/docs/",
    "spec/taxonomy/",
    "spec/fixtures/bootstrap-systems.json",
    "spec/fixtures/condition-rollup.json",
    "spec/fixtures/nameplate/",
    "spec/fixtures/components/",
    "spec/fixtures/event-application.json",
    "spec/fixtures/maintenance-schedule.json",
    "spec/fixtures/history-scopes.json",
    "spec/fixtures/notification-plan.json",
    "spec/fixtures/quick-log/",
    "spec/fixtures/recalls/",
    "spec/VERSION",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "bundle-schema": "tsx codegen/bundle-schema.ts",
    "codegen": "tsx codegen/generate-models.ts",
    "build": "tsx codegen/build-package.ts",
    "test:resolver": "tsx --test tests/schema-resolver.test.ts",
    "test:validator": "node --test tests/validator.test.mjs",
    "test:fixtures": "node --test tests/fixture-references.test.mjs",
    "test:version": "node --test tests/version-consistency.test.mjs",
    "test:types": "tsc --noEmit --strict --module Node16 --moduleResolution Node16 --target ES2022 tests/typescript-consumer.ts",
    "test:consumer": "node tests/package-consumer.mjs",
    "test:roomplan": "node --test tests/roomplan-fixtures.test.mjs",
    "test:taxonomy": "node --test tests/taxonomy.test.mjs",
    "test:components": "node --test tests/components-fixtures.test.mjs",
    "test:phase6": "node --test tests/phase6-*.test.mjs",
    "test:render": "vitest run",
    "test": "npm run build && npm run test:resolver && npm run test:validator && npm run test:fixtures && npm run test:version && npm run test:types && npm run test:consumer && npm run test:roomplan && npm run test:taxonomy && npm run test:components && npm run test:phase6 && npm run test:render",
    "prepare": "npm run build",
    "prepack": "npm run build"
  },
  "dependencies": {
    "ajv-formats": "3.0.1"
  },
  "devDependencies": {
    "@apidevtools/json-schema-ref-parser": "16.0.2",
    "ajv": "^8.20.0",
    "json-canonicalize": "3.0.1",
    "quicktype": "26.0.0",
    "tsx": "4.23.13",
    "typescript": "^5.9.0",
    "vitest": "^3.2.4"
  }
}
