{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://homebody.app/schema/entities/home.schema.json",
  "title": "Home",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "owner_user_id", "name", "address", "created_at"],
  "properties": {
    "id": { "type": "string", "format": "uuid" },
    "owner_user_id": { "type": "string", "format": "uuid" },
    "name": { "type": "string" },
    "address": { "type": "string" },
    "parcel_id": { "type": ["string", "null"] },
    "year_built": { "type": ["integer", "null"] },
    "sq_ft": { "type": ["number", "null"] },
    "beds": { "type": ["integer", "null"] },
    "baths": { "type": ["number", "null"] },
    "lot_size_m2": { "type": ["number", "null"] },
    "maintenance_defaults": {
      "type": ["object", "null"],
      "description": "Per-home service interval overrides. Keys are component_type ids; a value is a whole number of days that overrides the taxonomy default_service_interval_days for that type in this home. A component's own service_interval_days still wins over both (D-03 resolution order).",
      "propertyNames": { "pattern": "^[a-z][a-z0-9_]{0,63}$" },
      "maxProperties": 100,
      "additionalProperties": { "type": "integer", "minimum": 1, "maximum": 3650 }
    },
    "created_at": { "type": "string", "format": "date-time" }
  }
}
